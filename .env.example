# ═══════════════════════════════════════════════════════════════════
# ai-query-runner — Environment Variables
# Copy this file to .env and fill in your values.
# (Never commit .env to version control)
# ═══════════════════════════════════════════════════════════════════

# ── AI Target ───────────────────────────────────────────────────────
# Which AI platform to use: gemini | perplexity | claude | google
TARGET_SITE=gemini

# ── Browser ─────────────────────────────────────────────────────────
# Run browser without a visible window (requires Xvfb on Linux if no display)
HEADLESS=false

# Path to Chrome/Chromium executable (optional — uses auto-detection or Playwright bundled)
# CHROMIUM_PATH=/usr/bin/google-chrome

# Directory to store persistent browser profile (sessions)
# Default: ~/.config/ai-query-runner/browser-profile (Linux)
# PROFILE_DIR=/path/to/custom/profile

# ── Rate Limiting ────────────────────────────────────────────────────
# Maximum queries per day (resets at midnight)
DAILY_LIMIT=150

# Min/max pause between queries in milliseconds (humanizing delay)
PAUSE_MIN_MS=5000
PAUSE_MAX_MS=15000

# Night quiet hours: queries suspended between NIGHT_START and NIGHT_END (24h clock)
NIGHT_START=23
NIGHT_END=7

# ── HTTP Bridge Server ───────────────────────────────────────────────
# Port for the HTTP bridge server (--server mode)
BRIDGE_PORT=3535

# ── Google Sheets (optional) ─────────────────────────────────────────
# Service Account JSON for Google Sheets read/write (stringify the JSON to one line)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# API Key for reading public Google Sheets (read-only, no service account needed)
# Also used by the "google-api" search target below.
# GOOGLE_API_KEY=YOUR_API_KEY_HERE

# ── Google Custom Search API (target: google-api) ────────────────────
# Query Google Search without a browser — fast, reliable, 100 free queries/day.
# Requires both GOOGLE_API_KEY (above) and GOOGLE_CSE_ID (below).
# Setup guide:
#   1. Go to console.cloud.google.com → enable "Custom Search JSON API" → create API key
#   2. Go to programmablesearchengine.google.com → create engine → enable "Search the entire web"
#   3. Copy the Search Engine ID (cx) shown after creation
# GOOGLE_CSE_ID=YOUR_SEARCH_ENGINE_ID_HERE

# ── DuckDuckGo Search (target: duckduckgo) ───────────────────────────
# Query DuckDuckGo Search without a browser and WITHOUT any API key.
# No setup needed — works out of the box.
# Recommended: set PAUSE_MIN_MS=8000 to avoid rate limits from DuckDuckGo.

# ── Output Formatting ────────────────────────────────────────────────
# Strip Markdown formatting from responses before writing to Excel/CSV (true | false)
STRIP_MARKDOWN=false
